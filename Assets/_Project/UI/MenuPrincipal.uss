/* Menu principal - Sub-Rust.
   UI Toolkit com layout responsivo: fundo full-screen, painel lateral e botoes
   com estados visuais. O fluxo de botoes fica em MenuPrincipal.cs. */

.raiz {
    flex-grow: 1;
    background-image: url("project://database/Assets/_Project/UI/Backgrounds/menu_castelo.png");
    background-size: cover;
    background-position: center;
}

.sombra-fundo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(1, 3, 7, 0.56);
}

.grade-fina {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(40, 0, 0, 0.08);
}

.conteudo {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    padding-left: 62px;
    padding-right: 48px;
    padding-top: 54px;
    padding-bottom: 34px;
}

.painel {
    width: 470px;
    max-width: 46%;
    align-self: center;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 28px;
    padding-bottom: 28px;
    background-color: rgba(3, 5, 9, 0.60);
    border-left-width: 1px;
    border-left-color: rgba(145, 20, 22, 0.82);
    border-top-width: 1px;
    border-top-color: rgba(210, 220, 232, 0.16);
    border-bottom-width: 1px;
    border-bottom-color: rgba(210, 220, 232, 0.08);
    border-right-width: 1px;
    border-right-color: rgba(210, 220, 232, 0.06);
    border-radius: 14px;
}

.logo-sub-rust {
    height: 154px;
    margin-left: -10px;
    margin-right: -10px;
    margin-bottom: 30px;
    background-image: url("project://database/Assets/_Project/UI/Backgrounds/logo_sub_rust_blood.png");
    background-size: contain;
    background-position: center;
}

.tela {
    align-items: stretch;
}

.cabecalho-tela {
    -unity-font-style: bold;
    font-size: 22px;
    color: rgb(226, 230, 236);
    margin-bottom: 14px;
}

.botao {
    height: 56px;
    margin-bottom: 11px;
    font-size: 19px;
    color: rgb(224, 228, 235);
    background-color: rgba(9, 14, 21, 0.78);
    border-left-width: 2px;
    border-left-color: rgba(143, 29, 33, 0.76);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.13);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.55);
    border-radius: 15px;
    -unity-text-align: middle-left;
    padding-left: 26px;
    transition-property: background-color, border-left-color, padding-left, color;
    transition-duration: 0.12s;
}

.botao:hover {
    background-color: rgba(31, 38, 50, 0.92);
    border-left-color: rgb(190, 21, 29);
    color: rgb(255, 245, 238);
    padding-left: 36px;
}

.botao:active {
    background-color: rgba(84, 12, 18, 0.94);
}

.botao--principal {
    background-color: rgba(71, 13, 18, 0.86);
    border-left-color: rgb(207, 28, 38);
}

.botao--secundario {
    height: 48px;
    font-size: 16px;
    color: rgb(145, 153, 166);
    background-color: rgba(5, 8, 13, 0.62);
    border-left-color: rgba(73, 79, 91, 0.7);
}

.rotulo {
    font-size: 14px;
    color: rgb(178, 185, 196);
    margin-bottom: 7px;
}

.campo {
    height: 48px;
    font-size: 18px;
    margin-bottom: 16px;
}

.campo > .unity-base-text-field__input {
    background-color: rgba(8, 11, 16, 0.88);
    border-color: rgba(152, 33, 39, 0.46);
    border-width: 1px;
    color: rgb(240, 232, 214);
    padding-left: 12px;
}

.caixa-ip {
    background-color: rgba(8, 11, 16, 0.88);
    border-left-width: 2px;
    border-left-color: rgb(164, 30, 36);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
    padding: 14px 18px;
    margin-bottom: 20px;
    border-radius: 5px;
}

.ip-valor {
    font-size: 24px;
    color: rgb(226, 230, 236);
    -unity-font-style: bold;
}

.slider {
    margin-bottom: 18px;
}

.toggle {
    margin-bottom: 18px;
    color: rgb(220, 222, 226);
    font-size: 15px;
}

.status {
    min-height: 24px;
    font-size: 14px;
    color: rgb(172, 179, 190);
    -unity-text-align: middle-left;
    margin-top: 12px;
    white-space: normal;
}

.status--erro {
    color: rgb(234, 109, 87);
}

.escondido {
    display: none;
}

.lista-dev {
    max-height: 360px;
    margin-bottom: 11px;
}

.botao--area {
    height: 44px;
    font-size: 15px;
}
